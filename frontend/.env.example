# MedSync web app. Copy to .env.local for local development;
# on Vercel set these in the web project's Environment Variables.

# Supabase Dashboard -> Project Settings -> API (anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: account deletion (Supabase Dashboard -> Project Settings -> API Keys). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel AI Gateway key for local development. On Vercel the project authenticates automatically (OIDC).
AI_GATEWAY_API_KEY=your-gateway-key

# Optional overrides ("provider/model" strings routed through the gateway)
# MEDSYNC_CHAT_MODEL=openai/gpt-4o-mini
# MEDSYNC_ROUTER_MODEL=openai/gpt-4o-mini
# MEDSYNC_EMBED_MODEL=openai/text-embedding-3-small   # must output 1536 dimensions
# MEDSYNC_FAITHFULNESS_DISABLED=true
