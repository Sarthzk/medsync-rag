# MedSync API configuration (backend). Copy to .env for local development;
# on Vercel set these in the medsync-api project's Environment Variables.

# Required
OPENAI_API_KEY=sk-proj-your-actual-key-here
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated browser origins allowed to call the API directly.
# The Next.js app calls the API server-to-server, so this mainly matters for tools.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional: models
# MEDSYNC_CHAT_MODEL=gpt-4o-mini
# MEDSYNC_ROUTER_MODEL=gpt-4o-mini           # intent classifier, retrieval filter, HyDE
# MEDSYNC_EMBED_MODEL=text-embedding-3-small   # must stay 1536-dim to match the DB schema

# Optional: feature flags / tuning
# MEDSYNC_LLM_DISABLED=false
# MEDSYNC_FAITHFULNESS_DISABLED=false
# MEDSYNC_TEMPERATURE=0
# MEDSYNC_MAX_TOKENS=400
# MEDSYNC_MAX_MEDICAL_TOKENS=1200
# COHERE_API_KEY=            # enables reranking

LOG_LEVEL=INFO
