# MedSync web app. Copy to .env.local for local development;
# on Vercel set these in the web project's Environment Variables.

# Supabase Dashboard -> Project Settings -> API (anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: account deletion (Supabase Dashboard -> Project Settings -> API Keys). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only OpenAI key: chat, reading report photos/PDFs, and embeddings.
OPENAI_API_KEY=your-openai-key

# Optional overrides (OpenAI model ids)
# MEDSYNC_CHAT_MODEL=gpt-4o-mini
# MEDSYNC_ROUTER_MODEL=gpt-4o-mini
# MEDSYNC_FAITHFULNESS_DISABLED=true
