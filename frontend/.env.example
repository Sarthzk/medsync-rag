# MedSync web app. Copy to .env.local for local development;
# on Vercel set these in the web project's Environment Variables.

# Supabase Dashboard -> Project Settings -> API (anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend base URL (server-side only). Local: http://localhost:8000
BACKEND_API_BASE_URL=http://localhost:8000   # BACKEND_API_URL is also accepted
